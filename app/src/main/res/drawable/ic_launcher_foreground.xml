<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground адаптивной иконки PisheBlok.
    Глиф целиком внутри safe-зоны (круг r≈33 от центра 54,54) —
    на круглых/сквиркл-масках ничего не обрезается.
    Лист рисуется ДО холодильника и выглядывает из-за верхнего правого угла.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- свежесть: лист выглядывает из-за холодильника -->
    <path
        android:fillColor="#FF74A83E"
        android:pathData="M62,32 C61.5,26.5 65.5,24.5 69.5,26.5 C69,31 66.5,33.5 62,32 Z" />

    <!-- корпус холодильника, кремовый -->
    <path
        android:fillColor="#FFFFF8F2"
        android:pathData="M46,31 H62 A9,9 0 0 1 71,40 V68 A9,9 0 0 1 62,77 H46 A9,9 0 0 1 37,68 V40 A9,9 0 0 1 46,31 Z" />

    <!-- перегородка морозилки -->
    <path
        android:pathData="M40,49 H68"
        android:strokeColor="#FFBF3F15"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- ручка морозилки (горизонтальная) -->
    <path
        android:pathData="M56,39 H62.5"
        android:strokeColor="#FFBF3F15"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- ручка холодильной камеры (вертикальная) -->
    <path
        android:pathData="M62.5,55 V68"
        android:strokeColor="#FFBF3F15"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
